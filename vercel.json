{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "routes": [
    {
      "src": "/(assets/.*|uploads/.*|resume\\.pdf|favicon\\.svg)",
      "has": [
        {
          "type": "host",
          "value": "resume\\.akashpanwar\\.dev"
        }
      ],
      "dest": "/$1"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "resume\\.akashpanwar\\.dev"
        }
      ],
      "dest": "/resume-site/index.html"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "resume\\.akashpanwar\\.dev"
        }
      ],
      "dest": "/resume-site/$1"
    }
  ]
}
