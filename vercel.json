{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/:path((?:assets|uploads)/.*|resume\\.pdf|favicon\\.svg)",
      "has": [{ "type": "host", "value": "resume.akashpanwar.dev" }],
      "destination": "/:path"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "resume.akashpanwar.dev" }],
      "destination": "/resume-site/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "resume.akashpanwar.dev" }],
      "destination": "/resume-site/:path*"
    }
  ]
}
